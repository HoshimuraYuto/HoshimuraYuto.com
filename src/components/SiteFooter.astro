---
import { SOURCE_URL } from "../data/profile";
---

<footer class="footer">
  <p>© 2026 Yuto Hoshimura</p>
  <p>
    このサイトはAstroで作り、Cloudflare Workersに置いています。
    <a href={SOURCE_URL} target="_blank" rel="noopener">
      ソース
    </a>
  </p>
  <p class="footer__stats" data-page-stats>
    このページの重さ: <span data-page-weight>—</span> / 今回の読み込み:{" "}
    <span data-page-transfer>—</span> / 閲覧環境: <span data-viewport>—</span>
  </p>
  <p>
    <a href="/credits">クレジット</a> /{" "}
    <a href="/privacy">プライバシーポリシー</a>
  </p>
</footer>

<style>
  .footer {
    border: 0 solid var(--color-line);
    border-top-width: 1px;
    box-sizing: border-box;
    color: var(--color-dim);
    display: grid;
    font-size: 0.75rem;
    gap: 0.25rem;
    margin: 3rem auto 0;
    max-width: calc(var(--page-width) - 3rem);
    padding-block: 2rem;
    width: calc(100% - 3rem);
  }

  .footer p {
    margin: 0;
  }

  .footer__stats {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { setupPageStats } from "../scripts/page-stats";

  for (const stats of document.querySelectorAll<HTMLElement>(
    "[data-page-stats]",
  )) {
    setupPageStats(stats);
  }
</script>
