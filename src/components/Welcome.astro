---
import { skyAt } from "../lib/sky/sky";
import { sampleHref, WEATHER_SAMPLES } from "../scripts/sky-debug";
import { TOKYO } from "../scripts/sky-hero";
import { formatJst, formatMoonAge, formatPlace } from "../scripts/sky-time";
import Glitch from "./Glitch.astro";
import SiteLog from "./SiteLog.astro";

// The caption is written at build time in the same format as the live one, so filling it in does not move the name.
const builtAt = new Date();
---

<main class="welcome">
  <section class="welcome__hero" id="top" data-sky-root>
    <canvas class="welcome__sky" data-sky-previous aria-hidden="true"></canvas>
    <canvas class="welcome__sky" data-sky-canvas aria-hidden="true"></canvas>
    <canvas
      class="welcome__sky welcome__sky--fall"
      data-sky-fall
      aria-hidden="true"
    ></canvas>
    <div class="welcome__veil" data-sky-veil aria-hidden="true"></div>
    <h1 class="welcome__name">
      Yuto
      <br />
      Hoshimura
    </h1>
    <p class="welcome__role">
      <Glitch kind="tilt">Engineer</Glitch> / Blogger
    </p>
    <p class="welcome__caption">
      <span class="welcome__caption-part" data-sky-caption="time">
        {formatJst(builtAt)}
      </span>
      <span class="welcome__caption-part" data-sky-caption="place">
        {formatPlace(TOKYO.latitude, TOKYO.longitude)}
      </span>
      <span class="welcome__caption-part" data-sky-caption="moon">
        {formatMoonAge(skyAt(builtAt, TOKYO).moon.age)}
      </span>
      <span
        class="welcome__caption-part welcome__caption-part--weather"
        data-sky-caption="weather"
        data-typing
      ></span>
    </p>
    <a class="welcome__more" href="#log">
      $ tail log ↓<span class="welcome__caret" aria-hidden="true"></span>
    </a>
    {import.meta.env.DEV && (
      <details class="welcome__debug">
        <summary>天気を試す(開発時のみ)</summary>
        <ul class="welcome__debug-list">
          {WEATHER_SAMPLES.map((sample) => (
            <li>
              <a href={sampleHref(sample)}>{sample.label}</a>
            </li>
          ))}
          <li>
            <a href="/">今の天気に戻す</a>
          </li>
        </ul>
      </details>
    )}
  </section>
  <SiteLog />
</main>

<style>
  .welcome {
    box-sizing: border-box;
    margin-inline: auto;
    max-width: var(--page-width);
    padding-inline: 1.5rem;
    width: 100%;
  }

  .welcome__hero {
    --sky-night-top: #07080c;
    --sky-night-low: #141824;
    --sky-day-top: #27405c;
    --sky-day-low: #6f8299;
    --sky-dusk-low: #a5705f;
    --sky-ground: #090a0d;
    --sky-sun: #f6f2e8;
    --sky-sun-low: #ec9668;
    --sky-moon: #eeeade;
    --sky-star-blue: #d0dcfa;
    --sky-star-white: #eceef2;
    --sky-star-red: #fadcc4;
    --sky-cloud-day: #b9bfc8;
    --sky-cloud-shade: #4a5059;
    --sky-cloud-night: #14161b;
    --sky-cloud-night-low: #3a3432;
    --sky-veil-day: #8e959e;
    --sky-veil-night: #1d1f24;
    --sky-snow-day: #aeb6c1;
    --sky-snow-night: #3d424b;
    --sky-fall: #dfe5ee;
    --sky-dust: #a8927a;
    --hero-rule: rgb(215 218 224 / 25%);
    --hero-ink: #000;

    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: flex-end;

    /* A short gap keeps the log close under the hero; sky-dusk.ts finishes the dusk before the log rises to the horizon. */
    margin-bottom: 6svh;
    min-height: 100svh;
    padding-block: 3rem 18svh;
    text-shadow:
      0 0 2px rgb(from var(--hero-ink) r g b / 80%),
      0 0 12px rgb(from var(--hero-ink) r g b / 60%),
      0 0 40px rgb(from var(--hero-ink) r g b / 45%);
  }

  /* The sky stays behind the whole page, so the hero has no bottom edge to cross while the veil darkens it. */
  .welcome__sky {
    display: block;
    height: 100svh;
    left: 0;
    position: fixed;
    top: 0;
    width: 100%;
    z-index: -1;
  }

  .welcome__veil {
    background: var(--color-bg);
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    z-index: -1;
  }

  /* Rain and snow fall in front of the sky and behind the name, and must not take clicks from the links below. */
  .welcome__sky--fall {
    pointer-events: none;
  }

  .welcome__hero > :not(.welcome__sky, .welcome__veil) {
    position: relative;
  }

  .welcome__name {
    align-self: flex-start;
    color: var(--color-strong);
    font-size: clamp(2.5rem, 9vw, 4rem);
    font-weight: bold;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0;

    /* The big name sits on the bright haze by day, so it needs a wider, darker halo than the small lines. */
    text-shadow:
      0 0 2px rgb(from var(--hero-ink) r g b / 85%),
      0 0 0.15em rgb(from var(--hero-ink) r g b / 55%),
      0 0 0.5em rgb(from var(--hero-ink) r g b / 40%);
  }

  .welcome__role {
    color: var(--color-strong);
    font-size: 1.125rem;
  }

  .welcome__caption {
    border: 0 solid var(--hero-rule);
    border-top-width: 1px;
    color: var(--color-dim);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    gap: 0 1em;
    letter-spacing: 0.02em;
    max-width: 28rem;
    padding-top: 0.75rem;
  }

  .welcome__caption-part:empty {
    display: none;
  }

  /* The build-time caption holds the space but is stale; it shows once the first sky has been drawn. */
  .welcome__hero:not([data-daylight]) .welcome__caption-part {
    visibility: hidden;
  }

  /* The weather arrives after the first paint, so it hangs below the caption instead of pushing the name up. */
  .welcome__caption-part--weather {
    left: 0;
    position: absolute;
    top: 100%;
    width: 100%;
  }

  .welcome__caption-part--weather[data-typing] {
    display: block;
  }

  .welcome__caption-part--weather[data-typing]::after {
    animation: welcome-caret 1.4s steps(1) infinite;
    background: currentcolor;
    content: "";
    display: inline-block;
    height: 1em;
    vertical-align: -0.15em;
    width: 0.5em;
  }

  .welcome__more {
    align-items: center;
    align-self: flex-start;
    color: var(--color-dim);
    display: inline-flex;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.75rem;
    gap: 0.5em;
    margin-top: 0.75rem;
    text-decoration: none;
  }

  .welcome__more:hover {
    color: var(--color-strong);
  }

  .welcome__caret {
    animation: welcome-caret 1.4s steps(1) infinite;
    background: currentcolor;
    height: 1em;
    width: 0.5em;
  }

  @keyframes welcome-caret {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome__caret,
    .welcome__caption-part--weather[data-typing]::after {
      animation: none;
    }
  }

  .welcome p {
    margin: 0;
  }

  /* The child selector outranks the hero's rule that makes its children relative. */
  .welcome__hero > .welcome__debug {
    background: rgb(from var(--hero-ink) r g b / 70%);
    border: 1px solid var(--hero-rule);
    border-radius: 0.375rem;
    bottom: 1rem;
    color: var(--color-dim);
    font-size: 0.75rem;
    max-width: 16rem;
    padding: 0.5rem 0.75rem;
    position: fixed;
    right: 1rem;
    z-index: 1;
  }

  .welcome__debug summary {
    cursor: pointer;
  }

  .welcome__debug-list {
    display: grid;
    gap: 0.25rem;
    list-style: none;
    margin: 0.5em 0 0;
    padding: 0;
  }

  .welcome__debug-list a {
    color: var(--color-strong);
  }
</style>

<script>
  import { setupSkyDusk } from "../scripts/sky-dusk";
  import { setupSkyHero } from "../scripts/sky-hero";

  for (const hero of document.querySelectorAll<HTMLElement>(
    "[data-sky-root]",
  )) {
    setupSkyHero(hero, location.search, { debug: import.meta.env.DEV });
    const veil = hero.querySelector<HTMLElement>("[data-sky-veil]");
    if (veil) {
      setupSkyDusk(veil, hero);
    }
  }
</script>
