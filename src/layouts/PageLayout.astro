---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description: string;
  indexed?: boolean;
}

const { title, description, indexed = true } = Astro.props;
---

<Layout
  title={`${title} | Yuto Hoshimura`}
  description={description}
  indexed={indexed}
>
  <main class="page">
    <h1 class="page__title">
      <slot name="title">{title}</slot>
    </h1>
    <slot />
    <p>
      <a href="/">トップへ戻る</a>
    </p>
  </main>
</Layout>

<style>
  .page {
    box-sizing: border-box;
    display: grid;
    gap: 2rem;
    justify-items: start;
    margin-inline: auto;
    max-width: var(--page-width);
    padding: 4rem 1.5rem;
    width: 100%;
  }

  .page__title {
    color: var(--color-strong);
    font-size: 1.5rem;
    line-height: 1.4;
    margin: 0;
  }
</style>

<style is:global>
  /* The body comes from each page's slot, which scoped styles here do not reach. */
  .page > * {
    max-width: 100%;
  }

  .page p {
    margin: 0;
  }

  .page h2 {
    color: var(--color-strong);
    font-size: 1.125rem;
    margin: 0;
  }

  .page section {
    display: grid;
    gap: 0.75rem;
  }
</style>
