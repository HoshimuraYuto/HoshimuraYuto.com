---
import Critter from "../components/Critter.astro";
import GlitchHunt from "../components/GlitchHunt.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import { GLITCH_COMPLETE } from "../scripts/glitch";
---

<Layout description="Yuto Hoshimuraのサイトです。東京の今の空と、作ったもの・書いたもの・使っている道具を載せています。">
  <link
    slot="head"
    rel="preconnect"
    href="https://mesonet.agron.iastate.edu"
    crossorigin
  />
  <link
    slot="head"
    rel="preconnect"
    href="https://api.github.com"
    crossorigin
  />
  <Welcome />
  <SiteFooter />
  <GlitchHunt />
  <Critter />
  <Critter appearsOn={GLITCH_COMPLETE} />
</Layout>
