{
  "name": "hoshimurayuto.com",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "pnpm type-check && oxfmt --check . && oxlint . && pnpm markuplint && pnpm stylelint && pnpm textlint && pnpm secretlint && knip",
    "fix": "oxfmt . && oxlint --fix . && pnpm markuplint --fix && pnpm stylelint --fix && pnpm textlint --fix",
    "type-check": "astro sync && tsc && tsc -p tsconfig.astro.json --runExternalCode",
    "markuplint": "markuplint --no-allow-warnings \"src/**/*.astro\"",
    "stylelint": "stylelint --ignore-path .gitignore --allow-empty-input \"**/*.{css,astro}\"",
    "textlint": "textlint --ignore-path .gitignore \"**/*.md\"",
    "secretlint": "secretlint --maskSecrets --secretlintignore .gitignore \"**/*\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.11",
    "suncalc": "2.1.4"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.3",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@hoshimurayuto/code-rules": "1.0.1",
    "@markuplint/astro-parser": "5.6.0",
    "@playwright/test": "1.65.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "astronomy-engine": "2.1.19",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "markuplint": "5.6.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "secretlint": "13.1.0",
    "stylelint": "18.0.0",
    "textlint": "15.8.0",
    "textlint-rule-ja-space-around-code": "3.0.4",
    "textlint-rule-ja-space-around-strong": "3.0.4",
    "textlint-rule-ja-space-between-half-and-full-width": "3.0.4",
    "textlint-rule-no-mixed-zenkaku-and-hankaku-alphabet": "1.0.1",
    "textlint-rule-prh": "6.1.1",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.20.0"
}
