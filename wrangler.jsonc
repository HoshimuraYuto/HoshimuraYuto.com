{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or Workers Builds deploys to another Worker.
  "name": "hoshimurayuto-com-2026",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  // `wrangler preview` refuses to run without this block, even an empty one.
  "previews": {},
  "preview_urls": true,
}
